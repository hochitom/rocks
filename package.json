{
  "name": "hochitom-rocks",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "setup-python": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r scripts/process-pin/requirements.txt",
    "process-pin": ".venv/bin/python scripts/process-pin/process_pin.py",
    "test:python": ".venv/bin/python -m pytest scripts/process-pin"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.19.1",
    "node-html-parser": "^9.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
