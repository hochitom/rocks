{
  "name": "hochitom-rocks",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "setup-python": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r scripts/process-pin/requirements.txt",
