---
/**
 * The pin as a 3D object, for the stage of the Vitrine. The model is built in the browser from the
 * pin's outline, texture, relief map and rim metal; Three.js is loaded only after the page is up.
 * Until then — and for good without WebGL — the cut-out photo stands in, with the gallery's tilt
 * and glint.
 *
 * Motion: `turn` (detail page) mostly faces the visitor with a gentle sway and turns all the way
 * round once per ≈ 12 s cycle; `sway` (hero) only sways. Dragging turns the pin; the motion pauses
 * and resumes ≈ 2.5 s later. With "reduce motion" the pin only moves when dragged.
 */
import '../../styles/tilt.css';
import { EXHIBIT_SIZES, modelData, type Exhibit } from './exhibit';

interface Props {
  exhibit: Exhibit;
  motion: 'turn' | 'sway';
  /**
   * `lazy` lets a script right after the viewer put another pin in the case before the photo is
   * fetched (the hero's random pin), so phones don't download two photos.
   */
  photoLoading?: 'eager' | 'lazy';
}

const { exhibit, motion, photoLoading = 'eager' } = Astro.props;
---
<pin-viewer data-motion={motion} {...modelData(exhibit)}>
  <div class="tilt">
    <img
      src={exhibit.src}
      srcset={exhibit.srcset}
      sizes={EXHIBIT_SIZES}
      alt={exhibit.alt}
      loading={photoLoading}
      fetchpriority="high"
      decoding="async"
    />
  </div>
</pin-viewer>

<script>
  import './element';
</script>

<style>
  pin-viewer {
    position: absolute;
    inset: 0;
    display: block;
  }
  .tilt {
    position: absolute;
    inset: 8%;
    transition: opacity 0.6s;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 18px 20px rgb(0 0 0 / 0.6));
  }
  /* The model takes over from the photo once its first frame is drawn. */
  pin-viewer :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s;
    cursor: grab;
    /* Vertical swipes still scroll the page on phones; sideways drags turn the pin. */
    touch-action: pan-y;
  }
  pin-viewer :global(canvas:active) {
    cursor: grabbing;
  }
  pin-viewer[data-state='3d'] :global(canvas) {
    opacity: 1;
  }
  pin-viewer[data-state='3d'] .tilt {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s,
      visibility 0s 0.6s;
  }
</style>
