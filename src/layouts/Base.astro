---
import '@fontsource/big-shoulders-display/800';
import '@fontsource/big-shoulders-display/900';
import '@fontsource-variable/newsreader/opsz';
import '@fontsource-variable/newsreader/opsz-italic';
import '../styles/global.css';
import { analyticsToken } from '../lib/analytics';

export type Section = 'pins' | 'map' | 'tour';

interface Props {
  /** Shown before the site name in the browser tab; the home page has none. */
  title?: string;
  /** Marks the matching entry in the main navigation. */
  section?: Section;
  /** One or two plain sentences for search results and link previews. */
  description?: string;
  /** Preview image for sharing (1200 × 630), as a path on this site; the general one by default. */
  image?: string;
}

const {
  title,
  section,
  description = 'hochitom’s Hard Rock Cafe pins: one pin from every cafe I have been to, each with the story of the trip.',
  image = '/og/default.png',
} = Astro.props;
const fullTitle = title ? `${title} · hochitom.rocks` : 'hochitom.rocks';
const absolute = (path: string) => new URL(path, Astro.site).href;
const nav: { section: Section; label: string; href: string }[] = [
  { section: 'pins', label: 'Pins', href: '/' },
  { section: 'map', label: 'Map', href: '/map/' },
  { section: 'tour', label: 'Tour', href: '/tour/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="hochitom.rocks" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(Astro.url.pathname)} />
    <meta property="og:image" content={absolute(image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      ></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/">
        <img src="/logo.svg" alt="" width="44" height="48" />
        <span class="name">hochitom<span>.rocks</span></span>
      </a>
      <nav class="site-nav" aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={item.section === section ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a href="/imprint/">Imprint &amp; privacy</a>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 20px var(--gutter);
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .wordmark img {
    display: block;
  }
  /* Stacked in capitals, like the plectrum pin's lock-up: the name big, ".rocks" spaced out in brass below. */
  .wordmark .name {
    font: 900 1.85rem/0.88 var(--display);
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .wordmark .name span {
    display: block;
    color: var(--brass);
    font-size: 0.5em;
    letter-spacing: 0.3em;
  }
  .site-nav {
    display: flex;
    gap: 18px 28px;
  }
  .site-nav a {
    color: var(--smoke);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }
  .site-nav a:hover {
    color: var(--bone);
  }
  .site-nav a[aria-current='page'] {
    color: var(--bone);
    border-bottom-color: var(--brass);
  }
  .site-footer {
    padding: 40px var(--gutter) 28px;
    color: var(--smoke);
    font-size: var(--text-small);
  }
</style>
