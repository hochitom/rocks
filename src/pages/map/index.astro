---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getCatalog, type CatalogPin } from '../../lib/catalog';
import { formatLong } from '../../lib/pin-date';
import type { GlobeData } from '../../scripts/globe';

// Every cafe I have a pin from, on a dotted brass globe. The cafe list is the page without the globe
// (no JavaScript or no WebGL); the globe script hides it once the globe runs.
const { cafes, route } = await getCatalog();
const countries = new Set(cafes.map((cafe) => cafe.countryCode)).size;
const count = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

// One small cut-out per pin, for the markers, the cafe card and the list.
const thumbs = new Map<string, string>();
for (const cafe of cafes) {
  for (const pin of cafe.pins) {
    thumbs.set(pin.slug, (await getImage({ src: pin.cutout, width: 112, format: 'webp' })).src);
  }
}
const thumb = (pin: CatalogPin) => thumbs.get(pin.slug)!;
const place = (cafe: (typeof cafes)[number]) => [cafe.cafeName, cafe.countryName].filter(Boolean).join(', ');

const data: GlobeData = {
  land: '/map/land.json',
  cafes: cafes.map((cafe) => ({
    id: cafe.id,
    city: cafe.city,
    place: place(cafe),
    lat: cafe.lat,
    lng: cafe.lng,
    pins: cafe.pins.map((pin) => ({ slug: pin.slug, city: pin.city, date: formatLong(pin.date), image: thumb(pin) })),
  })),
  route: route.map((cafe) => cafe.id),
};
---
<Base
  title="Map"
  section="map"
  description="Every Hard Rock Cafe I have a pin from, marked on a turning globe and joined in the order I visited them."
>
  <section class="globe-view">
    <script is:inline>
      // Decide before the first paint whether the globe can run, so the page doesn't jump from list to globe.
      (function () {
        try {
          var gl = document.createElement('canvas').getContext('webgl2') || document.createElement('canvas').getContext('webgl');
          if (!gl) return;
          var lose = gl.getExtension('WEBGL_lose_context');
          if (lose) lose.loseContext();
          document.currentScript.parentElement.classList.add('is-live');
        } catch (e) {}
      })();
    </script>
    <h1 class="globe-title">Around the world</h1>
    <div class="globe-stage"><div class="globe-markers"></div></div>
    <div class="globe-panel">
      <div class="cafe-card" id="cafe-card" hidden aria-live="polite"></div>
      <p class="lede">
        Every cafe I have a pin from: {count(cafes.length, 'cafe', 'cafes')} in {count(countries, 'country', 'countries')}.<span class="globe-only"> The line follows the order I got them in.</span>
      </p>
      <p class="globe-hint globe-only">Drag to turn the globe, scroll or pinch to zoom. Pick a pin to see where it’s from.</p>
    </div>
    <ul class="cafe-list">
      {cafes.map((cafe) => (
        <li id={`cafe-${cafe.id}`}>
          <p class="cafe-name"><strong>{cafe.city}</strong> <span>{place(cafe)}</span></p>
          <ul class="cafe-pins">
            {cafe.pins.map((pin) => (
              <li>
                <a href={`/pins/${pin.slug}/`}>
                  <img src={thumb(pin)} alt={`Hard Rock Cafe ${pin.city} pin`} width="56" height="56" loading="lazy" decoding="async" />
                  <time datetime={pin.date}>{formatLong(pin.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
    <script type="application/json" id="globe-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
  </section>
</Base>

<script>
  // The globe (Three.js) is loaded only where it can run; until then, and without it, the list stands.
  const view = document.querySelector<HTMLElement>('.globe-view');
  if (view?.classList.contains('is-live')) {
    import('../../scripts/globe')
      .then(({ startGlobe }) => startGlobe(view))
      .catch((error) => {
        view.classList.remove('is-live');
        console.error('The globe could not start; showing the list of cafes instead.', error);
      });
  }
</script>

<style>
  /* Without the globe: the outlined title on top, the cafes listed below it. */
  .globe-view {
    position: relative;
    padding: 0 var(--gutter) 40px;
  }
  .globe-title {
    margin: 8px 0 24px;
    font: 900 clamp(4rem, 12vw, 12rem) / 0.82 var(--display);
    letter-spacing: -0.01em;
    pointer-events: none;
    user-select: none;
    color: var(--brass);
  }
  @supports (-webkit-text-stroke: 1px) {
    .globe-title {
      color: transparent;
      -webkit-text-stroke: 1.5px rgb(201 162 75 / 0.55);
    }
  }
  .globe-stage,
  .globe-only {
    display: none;
  }
  .lede {
    max-width: var(--measure);
    margin: 0 0 28px;
    font-size: 1.05rem;
    line-height: 1.5;
  }
  .cafe-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cafe-name {
    margin: 0 0 6px;
    color: var(--smoke);
    font-size: var(--text-small);
  }
  .cafe-name strong {
    display: block;
    color: var(--bone);
    font: 800 var(--text-h3) / 1.2 var(--display);
    letter-spacing: 0.01em;
  }
  .cafe-pins {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cafe-pins a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--smoke);
    font-size: var(--text-small);
  }
  .cafe-pins a:hover {
    color: var(--bone);
  }
  .cafe-pins img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    filter: drop-shadow(1px 4px 3px rgb(0 0 0 / 0.5));
  }

  /* With the globe: full width and height under the navigation, the title huge behind it,
     the panel (card, lede, hint) as a layer over its lower left corner. */
  .globe-view.is-live {
    height: max(calc(100svh - 80px), 600px);
    padding: 0;
    overflow: hidden;
    background: radial-gradient(
      ellipse 38% 46% at 50% 50%,
      rgb(255 231 184 / 0.16),
      rgb(255 231 184 / 0.04) 55%,
      transparent 75%
    );
  }
  .is-live .globe-title {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    text-align: center;
    font-size: clamp(5rem, 15vw, 17rem);
  }
  .is-live .globe-stage {
    display: block;
    position: absolute;
    inset: 0;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
  }
  .is-live .globe-stage:active {
    cursor: grabbing;
  }
  .is-live .cafe-list {
    display: none;
  }
  .is-live .globe-only {
    display: revert;
  }
  .globe-stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .globe-markers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .is-live .globe-panel {
    position: absolute;
    left: var(--gutter);
    bottom: 28px;
    z-index: 3;
    width: min(340px, calc(100% - 2 * var(--gutter)));
    display: grid;
    gap: 14px;
    pointer-events: none;
  }
  .is-live .globe-panel > * {
    pointer-events: auto;
  }
  .is-live .lede {
    margin: 0;
    text-shadow:
      0 1px 12px var(--velvet),
      0 0 2px var(--velvet);
  }
  .globe-hint {
    margin: 0;
    color: var(--smoke);
    font-size: var(--text-small);
    text-shadow: 0 0 8px var(--velvet);
  }

  /* Markers and card are built by the globe script, hence :global. */
  .globe-markers :global(.globe-marker) {
    all: unset;
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    display: grid;
    place-items: center;
    pointer-events: auto;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .globe-markers :global(.globe-marker img) {
    width: 44px;
    height: 44px;
    object-fit: contain;
    filter: drop-shadow(1px 5px 4px rgb(0 0 0 / 0.6));
    transition: transform 0.15s;
  }
  .globe-markers :global(.globe-marker:hover img),
  .globe-markers :global(.globe-marker:focus-visible img),
  .globe-markers :global(.globe-marker[aria-expanded='true'] img) {
    transform: scale(1.25);
  }
  .globe-markers :global(.globe-marker:focus-visible) {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
    border-radius: 50%;
  }
  .globe-markers :global(.count) {
    position: absolute;
    right: 2px;
    bottom: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9px;
    background: var(--brass);
    color: var(--velvet);
    font: 700 11px/18px var(--serif);
    text-align: center;
  }
  .cafe-card {
    padding: 16px 18px 14px;
    border-radius: 3px;
    background: var(--felt);
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.5);
  }
  .cafe-card[hidden] {
    display: none;
  }
  .cafe-card :global(header) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
    color: var(--smoke);
    font-size: var(--text-small);
  }
  .cafe-card :global(button) {
    all: unset;
    cursor: pointer;
    padding: 0 6px;
    color: var(--smoke);
    font-size: 1.1rem;
  }
  .cafe-card :global(button:hover) {
    color: var(--bone);
  }
  .cafe-card :global(button:focus-visible) {
    outline: 2px solid var(--brass);
  }
  .cafe-card :global(ul) {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cafe-card :global(a) {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 12px;
    align-items: center;
    text-decoration: none;
  }
  .cafe-card :global(img) {
    width: 56px;
    height: 56px;
    object-fit: contain;
    filter: drop-shadow(1px 4px 3px rgb(0 0 0 / 0.5));
  }
  .cafe-card :global(strong) {
    display: block;
    font: 800 1.25rem / 1.1 var(--display);
    letter-spacing: 0.01em;
  }
  .cafe-card :global(a:hover strong) {
    color: var(--brass);
  }
  .cafe-card :global(time) {
    color: var(--smoke);
    font-size: var(--text-small);
  }

  /* Phones: the title stands above the globe, the panel spans the width at the bottom. */
  @media (max-width: 760px) {
    .globe-view.is-live {
      display: flex;
      flex-direction: column;
      height: max(86svh, 560px);
    }
    .is-live .globe-title {
      position: static;
      padding: 4px var(--gutter) 0;
      font-size: 21vw;
    }
    .is-live .globe-stage {
      position: relative;
      inset: auto;
      flex: 1;
    }
    .is-live .globe-panel {
      bottom: 16px;
    }
    .is-live .globe-hint {
      display: none;
    }
  }
</style>
