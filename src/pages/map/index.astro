---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContinentLinks from '../../components/ContinentLinks.astro';
import PinMap from '../../components/PinMap.astro';
import Base from '../../layouts/Base.astro';
import { getCatalog } from '../../lib/catalog';
import { mapDataOf } from '../../lib/map-data';
import { count } from '../../lib/text';

// Every cafe I have been to on a flat map: brass dots where I brought a pin home, rings where I didn't.
const { cafes, missingPins, continentPages, stats } = await getCatalog();
const everyPlace = [...cafes, ...missingPins];
const data = await mapDataOf(cafes, missingPins, everyPlace, 'world');
// The sentence counts Hard Rock Cafes (with a pin or without); side finds come on top.
const hardRockCafes = cafes.filter((cafe) => cafe.kind === 'hard-rock');
const cafeCount = hardRockCafes.length + missingPins.length;
const countries = new Set([...hardRockCafes, ...missingPins].map((place) => place.countryCode)).size;
---
<Base
  title="Map"
  section="map"
  description="Every Hard Rock Cafe I have been to on a map: where I brought a pin home, and where I didn't."
>
  <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'Map' }]} />
  <section class="map-page">
    <div class="map-head">
      <div>
        <h1 class="page-title">Every cafe I have been to</h1>
        <p class="lede">
          {count(cafeCount, 'cafe', 'cafes')} in {count(countries, 'country', 'countries')}{stats.sideFinds ? `, plus ${count(stats.sideFinds, 'side find', 'side finds')}` : ''}.
          A brass dot means I brought a pin home, a ring means I was there without one.
        </p>
      </div>
      <ContinentLinks continents={continentPages} />
    </div>
    <PinMap data={data} label="Map of every cafe I have been to" variant="world" />
    <ul class="legend" aria-label="Legend">
      <li><span class="dot"></span>Pin brought home</li>
      <li><span class="dot side-find"></span>Side find</li>
      <li><span class="dot missing"></span>Visited, no pin</li>
      <li><span class="land"></span>Country I have been to</li>
    </ul>
  </section>
</Base>

<style>
  .map-page {
    display: grid;
    /* One column, never wider than the screen: the continent pills scroll inside it on phones. */
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    padding: 16px var(--gutter) 40px;
  }
  .map-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 48px;
  }
  .lede {
    max-width: 60ch;
    margin: 8px 0 0;
    color: var(--smoke);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--smoke);
    font-size: var(--text-small);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .dot {
    width: 14px;
    height: 14px;
    border: 2px solid var(--velvet);
    border-radius: 50%;
    background: var(--brass);
  }
  .dot.side-find {
    box-shadow: 0 0 0 2px var(--bone);
  }
  .dot.missing {
    width: 11px;
    height: 11px;
    border: 1.5px solid var(--bone);
    background: transparent;
  }
  .land {
    width: 22px;
    height: 14px;
    border-radius: 2px;
    background: #4a2f33;
  }
</style>
