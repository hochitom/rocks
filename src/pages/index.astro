---
import { getImage } from 'astro:assets';
import ContinentLinks from '../components/ContinentLinks.astro';
import PinGrid from '../components/PinGrid.astro';
import Base from '../layouts/Base.astro';
import { getCatalog, type CatalogPin, type MissingPin } from '../lib/catalog';
import { cafePlace, missingId, missingPlace } from '../lib/map-data';
import { formatLong } from '../lib/pin-date';
import { byName } from '../lib/pin-order';
import { count } from '../lib/text';
import type { GlobeData } from '../scripts/globe';
import { hasWebGL2 } from '../scripts/webgl';

const { pins, cafes, route, stats, missingPins, continentPages } = await getCatalog();

// Pins, countries and year count the Hard Rock pins only; the side finds come on top.
const summary =
  `hochitom’s Hard Rock Cafe pins, collected since ${stats.firstYear}: ` +
  `${count(stats.pins, 'pin', 'pins')} from ${count(stats.countries, 'country', 'countries')}` +
  (stats.sideFinds ? `, plus ${count(stats.sideFinds, 'side find', 'side finds')}.` : '.');

/** The line under a missing pin's cafe: place, country, when I was there, and whether I missed it for good. */
const visited = (missing: MissingPin) =>
  [missing.place, missing.countryName, `visited ${formatLong(missing.date)}`, missing.closed && 'closed for good']
    .filter(Boolean)
    .join(', ');

// ---- Hero: the globe, turned to one pin's cafe at a time, newest pin first ----

/** Decides before the first paint whether the globe can run, so the hero doesn't jump. */
const liveCheck = `if ((${hasWebGL2})()) document.currentScript.parentElement.classList.add('is-live');`;

const cafeOf = new Map(cafes.flatMap((cafe) => cafe.pins.map((pin) => [pin.slug, cafe.id] as const)));
const thumbs = new Map<string, string>();
const photos = new Map<string, string>();
for (const pin of pins) {
  thumbs.set(pin.slug, (await getImage({ src: pin.cutout, width: 112, format: 'webp' })).src);
  photos.set(pin.slug, (await getImage({ src: pin.cutout, width: 240, format: 'webp' })).src);
}

/** What the hero shows of a pin; the script steps through these. */
const heroOf = (pin: CatalogPin) => ({
  slug: pin.slug,
  cafe: cafeOf.get(pin.slug)!,
  city: pin.city,
  title: pin.kind === 'side-find' ? pin.name : `Hard Rock Cafe ${pin.city}`,
  where: [pin.kind === 'side-find' ? `Side find · ${pin.city}, ${pin.countryName}` : pin.countryName, formatLong(pin.date)].join(' · '),
  short: `${pin.name}, ${formatLong(pin.date)}`,
  photo: photos.get(pin.slug)!,
  thumb: thumbs.get(pin.slug)!,
  alt: pin.alt,
});
const heroPins = pins.map(heroOf);
const current = heroPins[0];

const missingByName = [...missingPins].sort((a, b) => byName(a.city, b.city) || byName(a.place ?? '', b.place ?? ''));
const globe: GlobeData = {
  land: '/map/land.json',
  cafes: [
    ...cafes.map((cafe) => ({
      id: cafe.id,
      kind: cafe.kind,
      name: cafe.name,
      place: cafePlace(cafe),
      lat: cafe.lat,
      lng: cafe.lng,
      pins: cafe.pins.map((pin) => ({ slug: pin.slug, name: pin.name, date: formatLong(pin.date), image: thumbs.get(pin.slug)! })),
    })),
    ...missingByName.map((missing) => ({
      id: missingId(missing),
      kind: 'missing' as const,
      name: missing.city,
      place: missingPlace(missing),
      lat: missing.lat,
      lng: missing.lng,
      pins: [],
      visited: formatLong(missing.date),
      closed: missing.closed,
    })),
  ],
  route: route.map((stop) => (stop.kind === 'cafe' ? stop.cafe.id : missingId(stop.missing))),
};
const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---
<Base section="pins" description={summary}>
  <h1 class="visually-hidden">Hard Rock Cafe pins</h1>
  <section class="hero" aria-label="Where the pins come from">
    <script is:inline set:html={liveCheck} />
    <p class="hero-city" aria-hidden="true">{current?.city}</p>
    <div class="globe-stage"><div class="globe-markers"></div></div>

    {current && (
      <div class="hero-panel">
        <article class="hero-card" aria-live="polite">
          <img class="hero-photo" src={current.photo} alt={current.alt} width="112" height="112" />
          <div class="hero-text">
            <h2 class="hero-title"><a href={`/pins/${current.slug}/`}>{current.title}</a></h2>
            <p class="hero-where">{current.where}</p>
            <a class="hero-open" href={`/pins/${current.slug}/`}>Open the pin</a>
          </div>
        </article>
        <p class="intro">{summary}</p>
      </div>
    )}

    {current && (
      <nav class="hero-nav" aria-label="Travel between pins">
        <ol class="hero-strip">
          {heroPins.map((pin, index) => (
            <li>
              <a href={`/pins/${pin.slug}/`} data-index={index} aria-label={pin.short} aria-current={index === 0 ? 'true' : undefined}>
                <img src={pin.thumb} alt="" width="46" height="46" loading="lazy" decoding="async" />
              </a>
            </li>
          ))}
        </ol>
        <div class="hero-steps" hidden>
          <button type="button" class="step older">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            Older<span class="step-name"></span>
          </button>
          <span class="step-count">1 / {heroPins.length}</span>
          <button type="button" class="step newer" disabled>
            Newer<span class="step-name"></span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
          </button>
        </div>
        <p class="hero-hint globe-only">The globe turns to each cafe in the order I collected the pins. Arrow keys work too.</p>
      </nav>
    )}

    <script type="application/json" id="hero-pins" set:html={json(heroPins)} />
    <script type="application/json" id="globe-data" set:html={json(globe)} />
  </section>

  <section class="all-pins" aria-labelledby="all-pins-title">
    <div class="all-pins-head">
      <div>
        <h2 id="all-pins-title" class="page-title">All pins</h2>
        <p>{count(pins.length, 'pin', 'pins')}, newest first. Pick a continent to see its cafes on the map.</p>
      </div>
      <ContinentLinks continents={continentPages} world />
    </div>
    <PinGrid pins={pins} label="All pins" />
  </section>

  {missingPins.length > 0 && (
    <section id="unfinished-business">
      <h2>Unfinished business</h2>
      <p>Cafes I’ve been to without bringing a pin home. I’ll be back.</p>
      <ul>
        {missingPins.map((missing) => (
          <li class:list={{ closed: missing.closed }}>
            <strong>Hard Rock Cafe {missing.city}</strong>{' '}
            <span class="where">{visited(missing)}</span>
            {missing.note && <>{' '}<span class="note">{missing.note}</span></>}
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<script>
  import type { GlobeControl } from '../scripts/globe';

  // The hero steps from pin to pin (newest first): the card, the strip and the city behind change, and
  // where WebGL runs the globe turns to the pin's cafe. Without JavaScript the strip links to the pins.
  type HeroPin = { slug: string; cafe: string; city: string; title: string; where: string; short: string; photo: string; alt: string };
  const hero = document.querySelector<HTMLElement>('.hero');
  const pins: HeroPin[] = JSON.parse(document.querySelector('#hero-pins')?.textContent ?? '[]');
  if (hero && pins.length) {
    const city = hero.querySelector<HTMLElement>('.hero-city')!;
    const photo = hero.querySelector<HTMLImageElement>('.hero-photo')!;
    const titleLink = hero.querySelector<HTMLAnchorElement>('.hero-title a')!;
    const where = hero.querySelector<HTMLElement>('.hero-where')!;
    const open = hero.querySelector<HTMLAnchorElement>('.hero-open')!;
    const strip = hero.querySelector<HTMLElement>('.hero-strip')!;
    const links = [...strip.querySelectorAll<HTMLAnchorElement>('a')];
    const steps = hero.querySelector<HTMLElement>('.hero-steps')!;
    const older = steps.querySelector<HTMLButtonElement>('.older')!;
    const newer = steps.querySelector<HTMLButtonElement>('.newer')!;
    const position = steps.querySelector<HTMLElement>('.step-count')!;
    let globe: GlobeControl | undefined;
    let index = 0;

    function show(next: number) {
      index = Math.max(0, Math.min(pins.length - 1, next));
      const pin = pins[index];
      city.textContent = pin.city;
      photo.src = pin.photo;
      photo.alt = pin.alt;
      titleLink.textContent = pin.title;
      titleLink.href = open.href = `/pins/${pin.slug}/`;
      where.textContent = pin.where;
      links.forEach((link, i) => (i === index ? link.setAttribute('aria-current', 'true') : link.removeAttribute('aria-current')));
      // Keep the current thumbnail in view without scrolling the page.
      const link = links[index];
      strip.scrollTo({ left: link.offsetLeft - strip.clientWidth / 2 + link.offsetWidth / 2, behavior: 'smooth' });
      older.disabled = index === pins.length - 1;
      newer.disabled = index === 0;
      older.querySelector('.step-name')!.textContent = older.disabled ? '' : ` · ${pins[index + 1].title.replace('Hard Rock Cafe ', '')}`;
      newer.querySelector('.step-name')!.textContent = newer.disabled ? '' : ` · ${pins[index - 1].title.replace('Hard Rock Cafe ', '')}`;
      position.textContent = `${index + 1} / ${pins.length}`;
      globe?.turnTo(pin.cafe);
    }

    steps.hidden = false;
    older.addEventListener('click', () => show(index + 1));
    newer.addEventListener('click', () => show(index - 1));
    strip.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-index]');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      show(Number(link.dataset.index));
    });
    hero.addEventListener('keydown', (event) => {
      if ((event.target as Element).closest('input, textarea')) return;
      if (event.key === 'ArrowLeft') show(index - 1);
      else if (event.key === 'ArrowRight') show(index + 1);
      else return;
      event.preventDefault();
    });
    show(0);

    // The globe (Three.js) is loaded only where it can run; without it the hero works the same.
    if (hero.classList.contains('is-live')) {
      import('../scripts/globe')
        .then(({ startGlobe }) => {
          globe = startGlobe(hero, pins[index].cafe, (cafe) => {
            // A cafe on the globe: its newest pin.
            const newest = pins.findIndex((pin) => pin.cafe === cafe.id);
            if (newest !== -1) show(newest);
          });
        })
        .catch((error) => {
          hero.classList.remove('is-live');
          console.error('The globe could not start; the hero goes on without it.', error);
        });
    }
  }
</script>

<style>
  /* ---- Hero: the city outlined in brass, the globe in lamp light, the pin's card and the way to the next pin ---- */
  .hero {
    position: relative;
    min-height: max(calc(100svh - 92px), 640px);
    overflow: hidden;
    background: radial-gradient(
      ellipse 34% 46% at 62% 48%,
      var(--lamp-glow-inner),
      var(--lamp-glow-outer) 55%,
      transparent 75%
    );
  }
  .hero-city {
    position: absolute;
    top: 0;
    left: var(--gutter);
    margin: 0;
    font: 900 clamp(5rem, 17vw, 18rem) / 0.85 var(--display);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    color: var(--brass);
  }
  @supports (-webkit-text-stroke: 1px) {
    .hero-city {
      color: transparent;
      -webkit-text-stroke: 1.5px var(--brass-outline);
    }
  }
  .globe-stage,
  .globe-only {
    display: none;
  }
  .is-live .globe-stage {
    display: block;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 30%;
    right: 0;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
  }
  .is-live .globe-stage:active {
    cursor: grabbing;
  }
  .is-live .globe-only {
    display: revert;
  }
  .globe-stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .globe-markers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-panel {
    position: absolute;
    left: var(--gutter);
    bottom: 56px;
    z-index: 3;
    width: min(440px, calc(100% - 2 * var(--gutter)));
    display: grid;
    gap: 20px;
  }
  .hero-card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px;
    border-radius: 6px;
    background: var(--felt);
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.45);
  }
  .hero-photo {
    flex: none;
    width: 112px;
    height: 112px;
    object-fit: contain;
    filter: drop-shadow(2px 6px 5px rgb(0 0 0 / 0.55));
  }
  .hero-text {
    display: grid;
    gap: 4px;
    min-width: 0;
  }
  .hero-title {
    font: 800 2rem / 1 var(--display);
    letter-spacing: 0.01em;
  }
  .hero-title a {
    text-decoration: none;
  }
  .hero-title a:hover {
    color: var(--brass);
  }
  .hero-where {
    margin: 0;
    color: var(--smoke);
    font-size: var(--text-small);
  }
  .hero-open {
    justify-self: start;
    color: var(--brass);
    font-size: 0.95rem;
  }
  .intro {
    margin: 0;
    font-size: var(--text-h3);
    line-height: 1.5;
    text-shadow:
      0 1px 12px var(--velvet),
      0 0 2px var(--velvet);
  }

  .hero-nav {
    position: absolute;
    right: var(--gutter);
    bottom: 48px;
    z-index: 3;
    width: min(600px, 46%);
    display: grid;
    gap: 16px;
  }
  .hero-strip {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 4px 2px;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .hero-strip a {
    display: block;
    width: 56px;
    height: 56px;
    padding: 4px;
    border: 2px solid rgb(201 162 75 / 0.18);
    border-radius: 50%;
    opacity: 0.7;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .hero-strip a:hover {
    opacity: 1;
  }
  .hero-strip a[aria-current='true'] {
    border-color: var(--brass);
    background: var(--felt);
    opacity: 1;
  }
  .hero-strip img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .hero-steps {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
  }
  .hero-steps[hidden] {
    display: none;
  }
  .step {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 20px;
    border: 1.5px solid var(--brass);
    border-radius: 999px;
    background: rgb(28 19 21 / 0.6);
    color: var(--bone);
    font: inherit;
    font-size: 1rem;
    cursor: pointer;
  }
  .step svg {
    color: var(--brass);
  }
  .step:hover:not(:disabled) {
    background: var(--felt);
  }
  .step:disabled {
    border-color: var(--brass-line);
    color: var(--smoke);
    cursor: default;
  }
  .step:disabled svg {
    color: var(--smoke);
  }
  .step-name {
    color: var(--smoke);
  }
  .step-count {
    min-width: 76px;
    text-align: center;
    color: var(--brass);
    font: 800 1.6rem / 1 var(--display);
    font-variant-numeric: tabular-nums;
  }
  .hero-hint {
    margin: 0;
    text-align: right;
    color: var(--smoke);
    font-size: var(--text-small);
  }

  /* Markers are built by the globe script, hence :global. */
  .globe-markers :global(.globe-marker) {
    all: unset;
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px;
    display: grid;
    place-items: center;
    pointer-events: auto;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .globe-markers :global(.globe-marker img) {
    width: 40px;
    height: 40px;
    object-fit: contain;
    filter: drop-shadow(1px 5px 4px rgb(0 0 0 / 0.6));
    transition: transform 0.15s;
  }
  .globe-markers :global(.globe-marker:hover img),
  .globe-markers :global(.globe-marker:focus-visible img) {
    transform: scale(1.25);
  }
  /* The current pin's cafe: bigger, in a brass ring. */
  .globe-markers :global(.globe-marker.is-current) {
    z-index: 1;
  }
  .globe-markers :global(.globe-marker.is-current img) {
    transform: scale(1.5);
  }
  .globe-markers :global(.globe-marker.is-current::after) {
    content: '';
    position: absolute;
    inset: -16px;
    border: 2px solid var(--brass);
    border-radius: 50%;
  }
  /* A side find's place: a fine bone ring around the photo, so it reads as not a cafe. */
  .globe-markers :global(.globe-marker.side-find::before) {
    content: '';
    position: absolute;
    inset: 1px;
    border: 1.5px solid var(--bone);
    border-radius: 50%;
    opacity: 0.55;
  }
  .globe-markers :global(.globe-marker.side-find .count) {
    background: var(--bone);
  }
  /* A missing pin: only a dashed brass ring where the pin would be, the space left for it. */
  .globe-markers :global(.globe-marker.missing) {
    pointer-events: none;
    cursor: default;
  }
  .globe-markers :global(.globe-marker.missing::before) {
    content: '';
    width: 16px;
    height: 16px;
    border: 1.5px dashed var(--brass-highlight);
    border-radius: 50%;
    background: rgb(28 19 21 / 0.55);
  }
  .globe-markers :global(.globe-marker:focus-visible) {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
    border-radius: 50%;
  }
  .globe-markers :global(.count) {
    position: absolute;
    right: 0;
    bottom: 0;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9px;
    background: var(--brass);
    color: var(--velvet);
    font: 700 11px/18px var(--serif);
    text-align: center;
  }

  /* Phones and small windows: everything one under the other, the city at the top. */
  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 0 var(--gutter) 32px;
      background: radial-gradient(
        circle at 50% 30%,
        var(--lamp-glow-inner),
        var(--lamp-glow-outer) 45%,
        transparent 65%
      );
    }
    .hero-city {
      position: static;
      font-size: 24vw;
    }
    .is-live .globe-stage {
      position: relative;
      inset: auto;
      height: min(92vw, 420px);
      margin: calc(-1 * min(14vw, 64px)) calc(-1 * var(--gutter)) 0;
    }
    .hero-panel,
    .hero-nav {
      position: static;
      width: auto;
    }
    .hero-panel {
      display: contents;
    }
    .intro {
      order: 1;
      font-size: 1rem;
    }
    .hero-card {
      gap: 14px;
      padding: 14px 16px;
    }
    .hero-photo {
      width: 72px;
      height: 72px;
    }
    .hero-title {
      font-size: 1.5rem;
    }
    .hero-steps {
      justify-content: space-between;
    }
    .step-name,
    .hero-hint {
      display: none;
    }
    .hero-strip a {
      width: 48px;
      height: 48px;
    }
  }

  /* ---- All pins: one list on felt, with the ways onto the map above it ---- */
  .all-pins {
    display: grid;
    gap: 28px;
    padding: 72px var(--gutter) 40px;
  }
  .all-pins-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 48px;
  }
  .all-pins-head p {
    margin: 6px 0 0;
    color: var(--smoke);
  }

  /* ---- Unfinished business: the cafes without a pin, a plain list on velvet ---- */
  #unfinished-business {
    padding: 40px var(--gutter) 64px;
  }
  #unfinished-business h2 {
    margin: 0 0 6px;
    font: 900 var(--text-h2) / 1 var(--display);
    color: var(--brass);
  }
  #unfinished-business > p {
    margin: 0 0 28px;
    color: var(--smoke);
  }
  #unfinished-business ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 22px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #unfinished-business li {
    padding-left: 14px;
    border-left: 1px dashed var(--brass-outline);
  }
  #unfinished-business strong {
    display: block;
    font: 800 var(--text-h3) / 1.1 var(--display);
    letter-spacing: 0.01em;
  }
  #unfinished-business .where {
    display: block;
    color: var(--smoke);
    font-size: var(--text-small);
  }
  #unfinished-business .note {
    display: block;
    margin-top: 4px;
    font-style: italic;
  }
  #unfinished-business .closed {
    border-left-color: var(--brass-line);
  }
  #unfinished-business .closed strong {
    color: var(--smoke);
  }
</style>
