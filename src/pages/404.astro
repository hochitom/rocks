---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <article class="not-found">
    <h1 class="page-title">Not on the tour</h1>
    <p>There is no page at this address. Maybe the link is old, or a letter went missing on the way.</p>
    <p><a class="back" href="/">Back to all pins</a></p>
  </article>
</Base>

<style>
  .not-found {
    max-width: var(--measure);
    padding: 24px var(--gutter) 64px;
  }
  p {
    margin: 20px 0 0;
  }
  .back {
    color: var(--brass);
    font-size: 1.1rem;
  }
</style>
