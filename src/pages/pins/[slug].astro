---
import { render } from 'astro:content';
import Plaque from '../../components/Plaque.astro';
import PinViewer from '../../components/pin-viewer/PinViewer.astro';
import { exhibitOf } from '../../components/pin-viewer/exhibit';
import Vitrine from '../../components/Vitrine.astro';
import Base from '../../layouts/Base.astro';
import { getCatalog, type CatalogPin, type Neighbours } from '../../lib/catalog';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.pins.map((pin) => ({
    params: { slug: pin.slug },
    props: { pin, ...catalog.neighbours(pin.slug) },
  }));
}

const { pin, previous, next } = Astro.props as { pin: CatalogPin } & Neighbours;
const { Content } = await render(pin.entry);
const exhibit = await exhibitOf(pin);
---
<Base title={pin.city} section="pins">
  <article class="pin">
    <Vitrine city={pin.city} heading>
      <a slot="top" class="back" href="/">Back to all pins</a>
      <PinViewer exhibit={exhibit} motion="turn" />
    </Vitrine>
    <div class="details">
      <Plaque pin={pin} />
      <div class="story">
        <Content />
      </div>
      <nav class="pager" aria-label="More pins">
        {previous && <a rel="prev" href={`/pins/${previous.slug}/`}>Previous pin: <strong>{previous.city}</strong></a>}
        {next && <a rel="next" href={`/pins/${next.slug}/`}>Next pin: <strong>{next.city}</strong></a>}
      </nav>
    </div>
  </article>
</Base>

<style>
  .back {
    color: var(--smoke);
    font-size: var(--text-small);
  }
  /* Plaque and story side by side; on narrow screens the story goes below the plaque. */
  .details {
    display: grid;
    grid-template-columns: minmax(260px, 360px) minmax(0, var(--measure));
    gap: 32px 64px;
    align-items: start;
    padding: 0 var(--gutter) 40px;
  }
  .story {
    max-width: var(--measure);
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .story > :global(:first-child) {
    margin-top: 0;
  }
  .pager {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--brass-line);
  }
  .pager a {
    color: var(--smoke);
    text-decoration: none;
  }
  .pager strong {
    color: var(--bone);
    font: 800 var(--text-h3) / 1.2 var(--display);
    letter-spacing: 0.01em;
  }
  .pager a:hover strong {
    color: var(--brass);
  }
  .pager [rel='next'] {
    margin-left: auto;
    text-align: right;
  }
  @media (max-width: 760px) {
    .details {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
