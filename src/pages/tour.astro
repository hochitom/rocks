---
import Base from '../layouts/Base.astro';
import { getCatalog } from '../lib/catalog';
import { formatWithinYear } from '../lib/pin-date';
import { count } from '../lib/text';

// Like the back of a tour shirt: year by year, the cities I brought a pin home from. A cafe I left
// without a pin is a cancelled show: struck through.
const { tour } = await getCatalog();
---
<Base title="Tour" section="tour" description="Every city I brought a Hard Rock Cafe pin home from, year by year, like the back of a tour shirt.">
  <section class="tour">
    <h1 class="page-title">On tour</h1>
    <p class="intro">Every city I brought a pin home from, year by year.</p>
    {tour.map(({ year, pins, stops }) => (
      <section class="year" aria-labelledby={`year-${year}`}>
        <header>
          <h2 id={`year-${year}`}>{year}</h2>
          <p class="count">{pins.length ? count(pins.length, 'pin', 'pins') : 'no pin'}</p>
        </header>
        <ol class="stops">
          {stops.map((stop) => {
            const visit = stop.kind === 'pin' ? stop.pin : stop.missing;
            const when = formatWithinYear(visit.date);
            return (
              <li class:list={{ missing: stop.kind === 'missing' }}>
                {when ? <time class="when" datetime={visit.date}>{when}</time> : <span class="when" />}{' '}
                {stop.kind === 'pin' ? (
                  <a href={`/pins/${stop.pin.slug}/`}>{stop.pin.name}</a>
                ) : (
                  <del title="No pin from here yet">{stop.missing.city}</del>
                )}{' '}
                <span class="country">{visit.countryName}</span>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </section>
</Base>

<style>
  .tour {
    max-width: 920px;
    padding: 16px var(--gutter) 40px;
  }
  h1 {
    margin-bottom: 12px;
  }
  .intro {
    max-width: var(--measure);
    margin: 0 0 36px;
    color: var(--smoke);
  }
  /* Tour-shirt back print: the year on the left, its stops beside it. */
  .year {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0 32px;
    padding: 18px 0 14px;
    border-top: 1px solid var(--brass-line);
  }
  h2 {
    color: var(--brass);
    font: 900 var(--text-h2) / 0.9 var(--display);
    font-variant-numeric: tabular-nums;
  }
  .count {
    margin: 6px 0 0;
    color: var(--smoke);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }
  .stops {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stops li {
    display: grid;
    grid-template-columns: 5.5em minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 16px;
    padding: 4px 0;
    /* Same line height for date and city, so a stop without a date lines up like the others. */
    line-height: 1.25;
  }
  .when {
    color: var(--smoke);
    font-variant-numeric: tabular-nums;
  }
  .stops a {
    font: 800 var(--text-h3) / 1.25 var(--display);
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .stops a:hover {
    color: var(--brass);
  }
  .stops del {
    font: 800 var(--text-h3) / 1.25 var(--display);
    letter-spacing: 0.01em;
    color: var(--smoke);
    text-decoration-thickness: 2px;
    text-decoration-color: var(--brass);
  }
  .country {
    color: var(--smoke);
  }

  /* Phones: the year sits above its stops, the country below the city. */
  @media (max-width: 760px) {
    .year {
      grid-template-columns: 1fr;
    }
    .year header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 6px;
    }
    .stops li {
      grid-template-columns: 4.6em minmax(0, 1fr);
      gap: 0 16px;
    }
    .country {
      grid-column: 2;
      margin-top: -2px;
      font-size: var(--text-small);
    }
  }
</style>
